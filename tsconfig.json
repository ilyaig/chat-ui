{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "dom"],
    "baseUrl": ".",
    "paths": {
      "@core": ["src/app/core"],
      "@core/*": ["src/app/core/*"],
      "@shared": ["src/app/shared"],
      "@shared/*": ["src/app/shared/*"],
      "@features/*": ["src/app/features/*"],
      "@env": ["src/environments"],
      "@env/*": ["src/environments/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
